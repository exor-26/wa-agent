{
  "name": "wa-agent",
  "version": "1.0.0",
  "description": "Personal WhatsApp message handling with Baileys and Codex CLI.",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "start:bg": "node scripts/control.js start",
    "stop": "node scripts/control.js stop",
    "restart": "node scripts/control.js restart",
    "live": "node scripts/live.js",
    "media:setup": "node scripts/media-setup.js",
    "status": "node scripts/status.js",
    "check": "node scripts/check.js && node --test",
    "test": "node --test",
    "doctor": "node scripts/doctor.js",
    "smoke": "node scripts/smoke.js",
    "pair": "node scripts/pair.js"
  },
  "keywords": [
    "whatsapp",
    "baileys",
    "codex",
    "assistant",
    "automation"
  ],
  "author": "Aditya Singh",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/exor-26/wa-agent.git"
  },
  "bugs": {
    "url": "https://github.com/exor-26/wa-agent/issues"
  },
  "homepage": "https://github.com/exor-26/wa-agent#readme",
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@whiskeysockets/baileys": "^7.0.0-rc.9",
    "dotenv": "^17.2.3",
    "ffmpeg-static": "^5.3.0",
    "pdfjs-dist": "^6.4.299",
    "pino": "^10.3.0",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.35.5",
    "yauzl": "^3.4.0"
  }
}
