# Optional: self-chat is also detected from the linked account identity.
CLARA_CHAT_JID=
OWNER_TAKEOVER_DELAY_SECONDS=14
AUTH_DIR=./auth
# Auto-discovers the Codex desktop binary on Windows when running in WSL.
CODEX_BIN=
CODEX_MODEL=gpt-6.1-sol
CODEX_TIMEOUT_SECONDS=90
WA_CONNECT_TIMEOUT_SECONDS=30
WA_RECONNECT_MAX_SECONDS=60
PROFILE_FILE=./data/profile.json
STATE_FILE=./data/state.json
CHAT_HISTORY_FILE=./chat-history.json
HISTORY_MAX_MESSAGES=30
MAX_PHOTO_MB=10
MAX_DOCUMENT_MB=10
MAX_AUDIO_MB=8
MAX_AUDIO_SECONDS=180
MAX_DOCUMENT_PAGES=20
MEDIA_TIMEOUT_SECONDS=120
LOG_MESSAGE_TEXT=false
